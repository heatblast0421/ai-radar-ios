# Copy to .env for local runs. NEVER commit real keys. In production these live in
# GitHub -> Settings -> Secrets and variables -> Actions.

# AI explanations (optional). Provider is detected from the key: gsk_ = Groq, xai- = xAI Grok,
# AIza = Google Gemini, sk-ant- = Anthropic, sk- = OpenAI.
LLM_API_KEY=your-llm-api-key-here
# LLM_MODEL=                 # optional: force a specific model id
# LLM_PROVIDER=              # optional: groq | xai | gemini | anthropic | openai
# LLM_MAX_CALLS_PER_RUN=6
# LLM_MAX_CALLS_PER_DAY=90
# LLM_MAX_TOKENS_PER_DAY=400000

# GitHub API token. In GitHub Actions the built-in GITHUB_TOKEN is used automatically.
GITHUB_TOKEN=your-github-token-here

AIRADAR_DB=data/radar.db
AIRADAR_SITE_DIR=site
# AIRADAR_DISABLED_SOURCES=aws-ml,venturebeat-ai
